# Gesty Configuration for Jetson Nano
# Source this file: source .env.jetson

# Lite mode: reduces inference frequency and memory usage
export GESTY_LITE_MODE=true

# Skip frames: 1=all frames, 2=every 2nd, 3=every 3rd, etc
export GESTY_SKIP_FRAMES=2

# Use lower resolution (640x480 instead of camera default)
export GESTY_LOWER_RESOLUTION=true

# Disable OpenCV visualization (headless mode)
export GESTY_DISABLE_VISUALIZATION=false

# GStreamer camera backend (recommended for RPi camera on Jetson)
# Set to true to use nvarguscamerasrc for CSI camera
export GESTY_USE_GSTREAMER=true

# Camera device (default 0 for /dev/video0 - RPi camera)
# For USB camera: 1 (or run 'v4l2-ctl --list-devices' to find)
export GESTY_CAMERA_INDEX=0

# FastAPI host and port
export GESTY_API_HOST=0.0.0.0
export GESTY_API_PORT=8120

# Inference confidence threshold (0.0-1.0)
export GESTY_CONFIDENCE=0.5
